---
import { Drawing } from "@/components/drawing"
import SiteFooter from "@/components/site-footer.astro"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
import { cn } from "@/lib/utils"
---

<Layout title="Page not found" hidden>
  <main id="content" class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
    <div class="@container" style="--drawing-size: 0.8rem">
      <Drawing name="dozer" label="A bulldozer pushing a heap of characters." />
    </div>
    <h1 class="type-display mt-12 text-5xl sm:text-6xl">Nothing here</h1>
    <p class="mt-4 max-w-[46ch] text-lg leading-relaxed text-muted-foreground">
      This page was moved or cleared away.
    </p>
    <div class="mt-7">
      <a href="/" class={cn(buttonVariants({ size: "lg" }))}>
        Go home
      </a>
    </div>
  </main>
  <SiteFooter />
</Layout>
