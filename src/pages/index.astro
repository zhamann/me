---
import {
  IconActivityHeartbeat,
  IconArrowsShuffle,
  IconCloud,
  IconKey,
  IconSparkles,
  IconTestPipe,
} from "@tabler/icons-react"

import { Drawing } from "@/components/drawing"
import Icon from "@/components/icon.astro"
import { ProjectCard } from "@/components/project-card"
import SiteFooter from "@/components/site-footer.astro"
import TenureRow from "@/components/tenure.astro"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
import { getProjects, projectPath, type Project } from "@/lib/projects"
import { education, experience, site, skills, systems } from "@/lib/site"
import { cn } from "@/lib/utils"

const projects = await getProjects()
const current = projects.filter((p) => p.data.status === "current")
const retired = projects.filter((p) => p.data.status === "retired")

const card = (project: Project) => ({
  id: project.id,
  href: projectPath(project),
  name: project.data.name,
  summary: project.data.summary,
  tags: project.data.tags,
})

const systemIcons: Record<string, typeof IconKey> = {
  "Process automation": IconArrowsShuffle,
  "Identity and access": IconKey,
  "Cloud infrastructure": IconCloud,
  "AI integration": IconSparkles,
  "Testing and CI": IconTestPipe,
  "Production operations": IconActivityHeartbeat,
}

const container = "mx-auto max-w-6xl px-5 sm:px-8"
const heading = "type-display text-4xl sm:text-5xl"
---

<Layout>
  <main id="content">
    <section
      class={cn(
        container,
        "grid items-center gap-x-10 gap-y-10 pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:pt-14"
      )}
    >
      <div>
        <h1 class="type-display text-6xl sm:text-7xl">{site.name}</h1>
        <p class="mt-4 text-xl text-muted-foreground">{site.role}</p>
        {site.intro.map((text) => (
          <p class="mt-5 max-w-[50ch] text-lg leading-relaxed text-foreground/85">
            {text}
          </p>
        ))}
        <div class="mt-8 flex flex-wrap gap-2">
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            class={cn(buttonVariants({ size: "lg" }))}
          >
            <Icon name="github" data-icon="inline-start" />
            GitHub
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener"
            class={cn(buttonVariants({ variant: "outline", size: "lg" }))}
          >
            <Icon name="linkedin" data-icon="inline-start" />
            LinkedIn
          </a>
          <a
            href={`mailto:${site.email}`}
            class={cn(buttonVariants({ variant: "outline", size: "lg" }))}
          >
            <Icon name="email" data-icon="inline-start" />
            Email
          </a>
        </div>
      </div>
      <div class="@container grid justify-center max-lg:order-first">
        <Drawing
          name="portrait"
          label="Zac in a backwards cap, smiling, drawn in characters."
        />
      </div>
    </section>

    <section
      id="projects"
      aria-labelledby="projects-heading"
      class={cn(container, "mt-28 sm:mt-36")}
    >
      <h2 id="projects-heading" class={heading}>
        Projects
      </h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {current.map((project, i) => (
          <li class={cn(i === 0 && "md:col-span-2")}>
            <ProjectCard {...card(project)} wide={i === 0} />
          </li>
        ))}
      </ul>
      <h3 class="type-title mt-16 text-2xl">Retired</h3>
      <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-6">
        {retired.map((project, i) => (
          <li class={i < 3 ? "lg:col-span-2" : "lg:col-span-3"}>
            <ProjectCard {...card(project)} />
          </li>
        ))}
      </ul>
    </section>

    <section
      id="experience"
      aria-labelledby="experience-heading"
      class={cn(container, "mt-28 sm:mt-36")}
    >
      <h2 id="experience-heading" class={heading}>
        Experience
      </h2>
      <div class="mt-10 flex flex-col gap-12">
        {experience.map((tenure) => (
          <TenureRow tenure={tenure} />
        ))}
      </div>
    </section>

    <section
      id="education"
      aria-labelledby="education-heading"
      class={cn(container, "mt-24 sm:mt-28")}
    >
      <h2 id="education-heading" class={heading}>
        Education
      </h2>
      <div class="mt-10 flex flex-col gap-12">
        {education.map((tenure) => (
          <TenureRow tenure={tenure} />
        ))}
      </div>
    </section>

    <section
      id="skills"
      aria-labelledby="skills-heading"
      class={cn(container, "mt-24 sm:mt-28")}
    >
      <h2 id="skills-heading" class={heading}>
        Skills
      </h2>
      <dl class="mt-10 flex flex-col gap-8">
        {skills.map((group) => (
          <div class="grid gap-x-12 gap-y-4 border-t pt-8 md:grid-cols-[minmax(0,17rem)_minmax(0,1fr)]">
            <dt class="type-title text-xl">{group.title}</dt>
            <dd class="flex flex-wrap gap-x-7 gap-y-4">
              {group.items.map((item) => (
                <span class="inline-flex items-center gap-2.5 text-lg">
                  <Icon name={item.icon} class="size-5 text-muted-foreground" />
                  {item.name}
                </span>
              ))}
            </dd>
          </div>
        ))}
        <div class="grid gap-x-12 gap-y-4 border-t pt-8 md:grid-cols-[minmax(0,17rem)_minmax(0,1fr)]">
          <dt class="type-title text-xl">Systems</dt>
          <dd class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
            {systems.map((system) => {
              const SystemIcon = systemIcons[system.name]
              return (
                <div>
                  <p class="flex items-center gap-2.5 text-lg">
                    <SystemIcon
                      className="size-5 shrink-0 text-muted-foreground"
                      stroke={1.75}
                      aria-hidden="true"
                    />
                    {system.name}
                  </p>
                  <ul class="mt-2.5 flex flex-wrap gap-1.5">
                    {system.tools.map((tool) => (
                      <li>
                        <Badge variant="secondary">{tool}</Badge>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            })}
          </dd>
        </div>
      </dl>
    </section>
  </main>
  <SiteFooter />
</Layout>
