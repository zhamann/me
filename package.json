{
  "name": "me",
  "description": "Zac Hamann's personal site, drawn in characters.",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "tools/lint/node_modules/.bin/bun lint",
    "format": "bun fmt \"**/*.{ts,tsx,astro}\"",
    "format:check": "bun fmt --check \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "check:lockfile": "bun tools/check-lockfile.mjs",
    "check:tests": "bun tools/check-tests.mjs",
    "test": "bun test --isolate"
  },
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.5",
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.52.0",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "bun"
  ],
  "overrides": {
    "fflate": "0.7.5"
  },
  "workspaces": [
    "tools/lint"
  ]
}
